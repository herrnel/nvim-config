#!/usr/bin/env bash
# dev-session — create, list, open, or remove persistent tmux dev sessions.
#
# New sessions use this layout:
#
#   +---------------+--------+
#   |     nvim      |        |
#   +---------------+   pi   |
#   |     shell     |        |
#   +---------------+--------+

set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  dev-session [NAME]        Open NAME, creating it in $PWD if needed
  dev-session open NAME     Open an existing session by name
  dev-session ls            List saved/running sessions
  dev-session rm NAME       Remove a session
  dev-session help          Show this help

With no NAME, the current directory's basename is used.
Tmux Continuum saves sessions every 15 minutes and restores them after restart.
EOF
}

normalize_name() {
  local name=$1
  # tmux session names cannot contain periods or colons.
  name=${name//./_}
  name=${name//:/_}
  printf '%s\n' "$name"
}

session_exists() {
  tmux has-session -t "=$1" 2>/dev/null
}

open_session() {
  local session=$1
  if ! session_exists "$session"; then
    echo "dev-session: no session named '$session'" >&2
    echo "Run 'dev-session ls' to list sessions." >&2
    return 1
  fi

  if [ -n "${TMUX:-}" ]; then
    exec tmux switch-client -t "=$session"
  else
    exec tmux attach-session -t "=$session"
  fi
}

list_sessions() {
  local rows
  if ! rows=$(tmux list-sessions \
      -F '#{session_name}|#{session_windows}|#{session_attached}|#{session_path}' \
      2>/dev/null); then
    echo "No tmux sessions."
    return 0
  fi

  printf '%-24s %-8s %-10s %s\n' 'NAME' 'WINDOWS' 'ATTACHED' 'DIRECTORY'
  while IFS='|' read -r name windows attached directory; do
    printf '%-24s %-8s %-10s %s\n' "$name" "$windows" "$attached" "$directory"
  done < <(printf '%s\n' "$rows" | sort)
  echo
  echo "Open one with: dev-session open NAME  (or: dev-session NAME)"
}

save_sessions() {
  local save_script="$HOME/.tmux/plugins/tmux-resurrect/scripts/save.sh"
  if [ -x "$save_script" ]; then
    "$save_script" >/dev/null
  fi
}

remove_session() {
  local session=$1
  local resurrect_dir
  resurrect_dir=$(tmux show-options -gqv @resurrect-dir 2>/dev/null || true)
  resurrect_dir=${resurrect_dir:-${XDG_DATA_HOME:-$HOME/.local/share}/tmux/resurrect}

  if ! session_exists "$session"; then
    echo "dev-session: no session named '$session'" >&2
    return 1
  fi

  # Killing the session that contains this command can terminate the command
  # before it updates the persisted snapshot.
  if [ -n "${TMUX:-}" ] && [ "$(tmux display-message -p '#S')" = "$session" ]; then
    echo "dev-session: cannot remove the session you are currently using" >&2
    echo "Switch to another session or detach first, then run: dev-session rm $session" >&2
    return 1
  fi

  tmux kill-session -t "=$session"
  if tmux list-sessions >/dev/null 2>&1; then
    save_sessions
  else
    # Removing the final session is intentional; prevent an older snapshot
    # from bringing it back the next time tmux starts.
    rm -f "$resurrect_dir/last"
  fi
  echo "Removed tmux session '$session'."
}

command=${1:-}
case "$command" in
  help|-h|--help)
    usage
    exit 0
    ;;
  ls|list)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    list_sessions
    exit 0
    ;;
  open)
    [ "$#" -eq 2 ] || { usage >&2; exit 2; }
    open_session "$(normalize_name "$2")"
    ;;
  rm|remove|delete)
    [ "$#" -eq 2 ] || { usage >&2; exit 2; }
    remove_session "$(normalize_name "$2")"
    exit 0
    ;;
  '')
    SESSION=$(normalize_name "$(basename "$PWD")")
    ;;
  *)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    SESSION=$(normalize_name "$1")
    ;;
esac

# Existing sessions include sessions restored automatically by tmux-continuum.
if session_exists "$SESSION"; then
  open_session "$SESSION"
fi

# Create a new three-pane development session.
NVIM_PANE=$(tmux new-session -d -s "$SESSION" -n main -c "$PWD" \
  -P -F '#{pane_id}')
PI_PANE=$(tmux split-window -h -l 10% -t "$NVIM_PANE" -c "$PWD" \
  -P -F '#{pane_id}')
SHELL_PANE=$(tmux split-window -v -l 30% -t "$NVIM_PANE" -c "$PWD" \
  -P -F '#{pane_id}')

tmux send-keys -t "$NVIM_PANE" 'nvim .' C-m
tmux send-keys -t "$PI_PANE" 'pi' C-m
# $SHELL_PANE intentionally remains a normal shell.
tmux select-pane -t "$NVIM_PANE"
save_sessions

if [ -n "${TMUX:-}" ]; then
  exec tmux switch-client -t "=$SESSION"
else
  exec tmux attach-session -t "=$SESSION"
fi
